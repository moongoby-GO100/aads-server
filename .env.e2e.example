# E2E credential env sample.
# Copy to .env.e2e.local for local runs. Do not commit real passwords.

NEWTALK_V1_PROJECT=NTV2

NEWTALK_V1_ADMIN_SERVICE=newtalk-v1-admin
NEWTALK_V1_ADMIN_LABEL=관리자
NEWTALK_V1_ADMIN_LOGIN_URL=https://newtalk.kr/auth/login
NEWTALK_V1_ADMIN_USERNAME=
NEWTALK_V1_ADMIN_PASSWORD=

NEWTALK_V1_WHOLESALE_SERVICE=newtalk-v1-wholesale
NEWTALK_V1_WHOLESALE_LABEL=도매
NEWTALK_V1_WHOLESALE_LOGIN_URL=https://newtalk.kr/auth/login
NEWTALK_V1_WHOLESALE_USERNAME=
NEWTALK_V1_WHOLESALE_PASSWORD=

NEWTALK_V1_RETAIL_SERVICE=newtalk-v1-retail
NEWTALK_V1_RETAIL_LABEL=소매
NEWTALK_V1_RETAIL_LOGIN_URL=https://pick.newtalk.kr/auth/login
NEWTALK_V1_RETAIL_USERNAME=
NEWTALK_V1_RETAIL_PASSWORD=
