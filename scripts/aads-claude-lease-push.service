[Unit]
Description=AADS Claude lease push — contabo116 → 원격 러너 서버 임시 출입증 갱신
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 모든 원격 러너는 contabo116이 갱신한 단기 access-token lease만 받는다.
# refresh token은 중앙 슬롯 홈 밖으로 복제하지 않는다.
Environment="CLAUDE_LEASE_TARGETS=root@5.104.86.14 root@114.207.244.86 root@5.104.85.244"
Environment="SLOT_LEASE_TARGETS=5.104.86.14 114.207.244.86 5.104.85.244"
ExecStart=/root/aads/aads-server/scripts/claude-lease-push.sh
ExecStart=/root/aads/aads-server/scripts/slot_lease_push.sh
TimeoutStartSec=180
Nice=5
