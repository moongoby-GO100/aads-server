[Unit]
Description=AADS Qwen3 document embedding worker
After=network-online.target ollama.service
Wants=network-online.target
ConditionHost=!contabo14

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aads-qwen3-worker/current
# Reuse the protected PG* settings that already point at the loopback SSH tunnel.
EnvironmentFile=-/root/.config/aads-runner.env
EnvironmentFile=-/etc/aads/qwen3-embedding-worker.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/aads-qwen3-worker/current/.venv/bin/python /opt/aads-qwen3-worker/current/qwen3_embedding_worker.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
