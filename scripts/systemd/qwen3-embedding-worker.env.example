# No secrets belong in this file. DB credentials are injected on each host.
# Set host identity locally when needed (supported: cafe24_114, jinah244).
QWEN_WORKER_SITE=SET_ME
QWEN_OLLAMA_URL=http://127.0.0.1:11434
# Prefer an SSH tunnel on loopback. A non-loopback URL is rejected unless TLS is required.
QWEN_DATABASE_URL=postgresql://SET_ME@127.0.0.1:15433/aads
QWEN_MAX_CONCURRENCY=3
QWEN_LEASE_SECONDS=90
