# No secrets belong in this file. DB credentials are injected on each host.
# Set host identity locally when needed (supported: cafe24_114, jinah244).
QWEN_WORKER_SITE=SET_ME
QWEN_OLLAMA_URL=http://127.0.0.1:11434
# Optional override. By default the worker reuses protected PG* tunnel settings
# from /root/.config/aads-runner.env. Non-loopback URLs require TLS.
QWEN_DATABASE_URL=
QWEN_MAX_CONCURRENCY=3
QWEN_LEASE_SECONDS=90
# API defaults to shadow until offline evaluation explicitly approves another mode.
DOC_SEARCH_MODE=shadow
