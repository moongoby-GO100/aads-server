[Unit]
# 진아실장 서버(5.104.85.244, vmi3535008) 전용 러너 — ACCT(회계) 프로젝트.
#
# CEO 지시 2026-09-14: "진아서버에는 진아계정만 유지하고 사용한다."
# 2026-09-21 CEO 지시로 4개 슬롯의 단기 access-token lease를 사용한다.
# refresh token은 contabo116에만 남고, 이 서버는 /root/.claude-lease 읽기 전용이다.
#
# 동시 실행을 2로 묶는 이유: 계정이 개인 구독 하나뿐이라 한도를 태우면
# 진아실장 본인 작업까지 같이 막힌다. 공용 서버(4)보다 보수적으로 둔다.
Description=AADS Pipeline Runner — ACCT (jinah244)
After=network.target aads-db-tunnel.service
Wants=aads-db-tunnel.service

[Service]
Type=simple
User=root
WorkingDirectory=/root
# 러너 본체는 ANTHROPIC_AUTH_TOKEN 이 비면 token_missing 으로 즉시 죽는다.
# 이 서버는 lease 를 받지 않으므로 래퍼가 /etc/biseo.env 의 진아 토큰을 꺼내 넣는다.
ExecStart=/root/scripts/runner_jinah_token_wrapper.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aads-pipeline-runner
EnvironmentFile=-/root/.config/aads-runner.env
Environment=DB_MODE=psql
Environment=RUNNER_PROJECTS=ACCT
Environment=RUNNER_ENGINE_MODE=general
Environment=AADS_RUNNER_HOST_NAME=jinah244
Environment=RUNNER_USE_SLOT_CREDENTIALS=0
Environment=CLAUDE_LEASE_SLOT_HOME_ROOT=/root/.claude-lease
Environment=RUNNER_CLAUDE_CLI_BIN=/usr/local/bin/claude-aads
Environment=AADS_API_URL=https://aads.newtalk.kr
Environment=POLL_INTERVAL=5
Environment=MAX_RUNTIME=7200
Environment=MAX_RETRIES=2
Environment=MAX_CONCURRENT_GLOBAL=2
Environment=MAX_CONCURRENT_PER_PROJECT=2
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
LimitNOFILE=65535
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
