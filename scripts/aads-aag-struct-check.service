[Unit]
# AAG L1/L2 — 구조(라우트·테이블·프런트 호출)에서 설계 사고를 찾는다.
#
# pre-commit 게이트는 aads-server 저장소를 건드린 커밋에서만 돈다.
# 그런데 이 스캔의 절반은 **다른 저장소**(aads-dashboard)를 본다 —
# 대시보드에서 fetch 경로 한 줄만 바꿔도 ROUTE_MISSING 이 늘지만
# aads-server 에는 커밋이 없어 pre-commit 이 돌지 않는다.
# 저장소 경계를 넘는 표류는 타이머가 아니면 아무도 못 본다.
Description=AADS AAG L1/L2 structural architecture check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/aads/aads-server
# 종료코드 1 = 고정선보다 늘었다(지적 있음 — 정상 동작).
# 종료코드 2 = 스캔 불가(대상 0개) — 이것만 실패로 남긴다.
#              "위반 0건" 과 "점검 못함" 을 같은 초록불로 만들지 않는다.
SuccessExitStatus=0 1
# 리포트는 저장소 밖에 쓴다. 저장소 안에 쓰면 30분마다 워킹트리가 더러워져
# 다른 세션의 git status 판단을 망가뜨린다.
ExecStart=/usr/bin/python3 /root/aads/aads-server/tools/aag/scan_aads.py \
    --check-baseline \
    --out-dir /var/log/aads-pipeline/aag-struct
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aads-aag-struct
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
