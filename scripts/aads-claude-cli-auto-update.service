[Unit]
Description=AADS gated Claude CLI patch updater
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/aads/aads-server
ExecStart=/root/aads/aads-server/.venv/bin/python /root/aads/aads-server/scripts/claude_cli_auto_update.py --apply
TimeoutStartSec=2h
Nice=10

