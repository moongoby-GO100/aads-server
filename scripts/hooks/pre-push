#!/bin/bash
# pre-push hook: 커밋 SHA 별 pre-commit 통과 서명 검증
#
# 왜 sha 별인가 (2026-09-14)
#   예전 방식은 저장소당 마커 파일 하나(.git/HOOK_VERIFIED)를 쓰고 push 성공 시
#   그것을 rm 했다. 그래서 동시 세션이 서로의 서명을 소비했다 — 실측:
#   08:56:34 세션A 커밋(마커 생성) → 08:57:10 세션B 커밋(마커 갱신)
#   → 세션B push 가 마커 삭제 → 08:57:5x 세션A push 가 "서명 없음" 으로 차단.
#   차단 메시지는 --no-verify 를 지목했지만 오진이었고, 그 오진이 에이전트를
#   ALLOW_FORCE_PUSH=1 우회로 몰았다. 게이트가 거짓 양성을 내면 무력화된다.
#
#   이제 pre-commit 이 PENDING 을 쓰고 post-commit 이 그것을 .git/hook_verified/<sha>
#   로 옮긴다. --no-verify 는 pre-commit 을 건너뛰므로 PENDING 이 없고 마커도 안 생긴다.
#   pre-push 는 삭제하지 않는다 — 소비하지 않으므로 경합 자체가 없다.
#
# 목업 승인 게이트 (R-DOC M8a)
#   서명 검증 뒤에 push 대상 커밋이 UI 파일을 바꾸는지 본다. 바꾸면 scripts/verify_mockup_approval.py 를
#   phase=pre_push 로 호출해 커밋 메시지의 MOCKUP_REVIEW_ID / MOCKUP_REVISION_ID / MOCKUP_MANIFEST_HASH 선언을
#   검증한다. MOCKUP_GATE_MODE=shadow(기본)에서는 경고만 하고 판정을 API 가 DB 에 남긴다. enforce 일 때만 막는다.
#   API 가 응답하지 않으면 shadow 는 통과, enforce 는 막는다. 이 게이트는 서명 유예(.since)와 무관하게 돈다.
#
# 긴급 우회 (CEO 승인 필요): ALLOW_FORCE_PUSH=1 git push

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

if [ "${ALLOW_FORCE_PUSH:-}" = "1" ]; then
    echo -e "${YELLOW}[pre-push] ⚠️ ALLOW_FORCE_PUSH=1 — 서명 검증 생략${NC}"
    exit 0
fi

_GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)
[ -z "$_GIT_DIR" ] && exit 0
MARK_DIR="$_GIT_DIR/hook_verified"
SINCE_FILE="$MARK_DIR/.since"

# 워크트리에서 만든 서명도 본다 (2026-09-17).
#   워크트리에서 커밋하면 `git rev-parse --git-dir` 이
#   `.git/worktrees/<name>` 을 돌려주므로 pre-commit 은 서명을 거기에 쓴다.
#   그런데 push 는 보통 본체에서 하고, 본체 MARK_DIR 만 보면 그 서명이
#   안 보인다 — 실측으로 `.git/worktrees/aads-wt-runner-*/hook_verified/`
#   가 여럿 있었다. 러너가 워크트리에서 커밋할 때마다 거짓 양성이 났다.
#
#   본체 git-dir 을 구해 그 아래 worktrees 까지 훑는다.
_COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null)
[ -z "$_COMMON_DIR" ] && _COMMON_DIR="$_GIT_DIR"

# 서명이 어느 저장소 경로에든 있으면 통과.
_has_mark() {
    [ -f "$MARK_DIR/$1" ] && return 0
    [ -f "$_COMMON_DIR/hook_verified/$1" ] && return 0
    ls "$_COMMON_DIR"/worktrees/*/hook_verified/"$1" >/dev/null 2>&1 && return 0
    return 1
}

# 도입 이전 커밋은 마커가 있을 수 없다. 유예 기준이 없으면 검증을 건너뛴다
# (게이트 도입이 기존 이력 전체를 막아 세우는 일이 없도록).
SINCE=0
[ -f "$SINCE_FILE" ] && SINCE=$(cat "$SINCE_FILE" 2>/dev/null)
case "$SINCE" in ''|*[!0-9]*) SINCE=0 ;; esac

ZERO='0000000000000000000000000000000000000000'
UNVERIFIED=''
PUSH_LINES=$(cat)   # 서명 검사와 목업 게이트가 같은 push 목록을 두 번 읽는다

# push 로 올라가는 커밋 목록 (브랜치 삭제는 빈 목록)
_push_range() {
    [ -z "$2" ] && return 0
    [ "$2" = "$ZERO" ] && return 0
    if [ "$4" = "$ZERO" ]; then
        git rev-list "$2" --not --remotes 2>/dev/null | head -200
    else
        git rev-list "${4}..${2}" 2>/dev/null | head -200
    fi
}

[ "$SINCE" = "0" ] && PUSH_SIG_LINES='' || PUSH_SIG_LINES="$PUSH_LINES"
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$ZERO" ] && continue           # 브랜치 삭제
    RANGE=$(_push_range "$local_ref" "$local_sha" "$remote_ref" "$remote_sha")
    for sha in $RANGE; do
        _has_mark "$sha" && continue
        # 머지 커밋은 pre-commit 이 아니라 pre-merge-commit 경로라 마커가 없다
        if [ "$(git rev-list --parents -n 1 "$sha" 2>/dev/null | wc -w)" -gt 2 ]; then
            continue
        fi
        # 게이트 도입 이전 커밋 유예
        CTS=$(git show -s --format=%ct "$sha" 2>/dev/null)
        case "$CTS" in ''|*[!0-9]*) CTS=0 ;; esac
        [ "$CTS" -lt "$SINCE" ] && continue
        UNVERIFIED="$UNVERIFIED $sha"
    done
done <<< "$PUSH_SIG_LINES"

if [ -n "$UNVERIFIED" ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}[pre-push] ❌ pre-commit 서명이 없는 커밋${NC}"
    for sha in $UNVERIFIED; do
        echo -e "${RED}  $(git log -1 --format='%h %s' "$sha" 2>/dev/null)${NC}"
    done
    echo -e "${RED}원인은 둘 중 하나입니다. 순서대로 확인하세요.${NC}"
    echo -e "${YELLOW}  1) rebase 로 서명이 떨어져 나갔나 (가장 흔함)${NC}"
    echo -e "     git reflog | head -20    ← 'pull --rebase' 가 보이면 이 경우입니다"
    echo -e "     post-rewrite 훅이 서명을 옮깁니다. 훅이 설치돼 있는지 보세요:"
    echo -e "${YELLOW}       ls -l .git/hooks/post-rewrite${NC}"
    echo -e "     없으면: cp scripts/hooks/post-rewrite .git/hooks/ && chmod +x .git/hooks/post-rewrite"
    echo -e "${YELLOW}  2) 정말 --no-verify 로 커밋했나${NC}"
    echo -e "     그렇다면 다시 커밋하세요: git commit --amend --no-edit"
    echo -e ""
    echo -e "${RED}ALLOW_FORCE_PUSH=1 은 CEO 승인 사항입니다. 먼저 위 둘을 확인하세요 —${NC}"
    echo -e "${RED}게이트가 거짓 양성을 내면 우회가 습관이 되고, 그러면 진짜 위반도 같이 통과합니다.${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
fi

[ "$SINCE" != "0" ] && echo -e "${GREEN}[pre-push] ✅ 모든 커밋 pre-commit 서명 확인${NC}"

# ── 목업 승인 게이트 (phase=pre_push) ──
_TOP=$(git rev-parse --show-toplevel 2>/dev/null)
MOCKUP_CLI="$_TOP/scripts/verify_mockup_approval.py"
MOCKUP_BLOCKED=''
if [ -n "$_TOP" ] && [ -f "$MOCKUP_CLI" ] && command -v python3 >/dev/null 2>&1; then
    _T=""; command -v timeout >/dev/null 2>&1 && _T="timeout 30"
    _FILES=$(mktemp); _MSG=$(mktemp)
    while read -r local_ref local_sha remote_ref remote_sha; do
        for sha in $(_push_range "$local_ref" "$local_sha" "$remote_ref" "$remote_sha"); do
            [ "$(git rev-list --parents -n 1 "$sha" 2>/dev/null | wc -w)" -gt 2 ] && continue   # 머지 커밋
            git diff-tree --no-commit-id --name-only -r --root "$sha" > "$_FILES" 2>/dev/null
            [ -s "$_FILES" ] || continue
            git log -1 --format=%B "$sha" > "$_MSG" 2>/dev/null
            OUT=$($_T python3 "$MOCKUP_CLI" --phase pre_push --task-id "push-${sha:0:12}" \
                --changed-files "$_FILES" --instruction-file "$_MSG" --timeout 10 2>&1); RC=$?
            case "$RC" in
                0)
                    if printf '%s' "$OUT" | grep -q '"applicable": false'; then
                        :   # UI 작업이 아니고 bundle 선언도 없음
                    elif printf '%s' "$OUT" | grep -q '"allowed": true' && ! printf '%s' "$OUT" | grep -q '"shadow": true'; then
                        :   # 승인된 bundle 로 검증 통과
                    else
                        echo -e "${YELLOW}[pre-push] ⚠️ 목업 승인 게이트(shadow, push 는 막지 않음) $(git log -1 --format='%h %s' "$sha" 2>/dev/null)${NC}"
                        echo -e "${YELLOW}    ${OUT:0:300}${NC}"
                    fi ;;
                10|20) MOCKUP_BLOCKED="$MOCKUP_BLOCKED $sha"
                    echo -e "${RED}[pre-push] ❌ 목업 승인 게이트 rc=$RC $(git log -1 --format='%h %s' "$sha" 2>/dev/null)${NC}"
                    echo -e "${RED}    ${OUT:0:300}${NC}" ;;
                *) echo -e "${YELLOW}[pre-push] ⚠️ 목업 승인 게이트 스크립트 오류 rc=$RC (push 는 막지 않음): ${OUT:0:200}${NC}" ;;
            esac
        done
    done <<< "$PUSH_LINES"
    rm -f "$_FILES" "$_MSG"
fi

if [ -n "$MOCKUP_BLOCKED" ]; then
    echo -e "${RED}UI 파일을 바꾸는 커밋은 승인된 목업 bundle 을 메시지에 선언해야 합니다:${NC}"
    echo -e "     MOCKUP_REVIEW_ID: <uuid>  MOCKUP_REVISION_ID: <uuid>  MOCKUP_MANIFEST_HASH: <sha256>"
    echo -e "${RED}MOCKUP_GATE_MODE 변경과 ALLOW_FORCE_PUSH=1 은 CEO 승인 사항입니다.${NC}"
    exit 1
fi
exit 0
