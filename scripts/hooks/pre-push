#!/bin/bash
# pre-push hook: HOOK_VERIFIED 서명 검증
# pre-commit을 --no-verify로 우회한 push를 차단
# 긴급 시: ALLOW_FORCE_PUSH=1 git push

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 긴급 우회 (CEO 승인 필요)
if [ "${ALLOW_FORCE_PUSH:-}" = "1" ]; then
    echo -e "${YELLOW}[pre-push] ⚠️ ALLOW_FORCE_PUSH=1 — 서명 검증 생략${NC}"
    exit 0
fi

_GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)
HOOK_FILE="$_GIT_DIR/HOOK_VERIFIED"

# 1. 서명 파일 존재 확인
if [ ! -f "$HOOK_FILE" ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}[pre-push] ❌ HOOK_VERIFIED 서명 파일 없음${NC}"
    echo -e "${RED}pre-commit hook이 실행되지 않았습니다.${NC}"
    echo -e "${RED}--no-verify로 커밋했다면, 다시 커밋하세요:${NC}"
    echo -e "${YELLOW}  git commit --amend --no-edit${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
fi

# 2. 서명 타임스탬프 추출
HOOK_SIG=$(cat "$HOOK_FILE" 2>/dev/null)
HOOK_TS=$(echo "$HOOK_SIG" | grep -oP 'hook-verified:\K[0-9]+' 2>/dev/null)

if [ -z "$HOOK_TS" ]; then
    echo -e "${RED}[pre-push] ❌ HOOK_VERIFIED 서명 포맷 오류${NC}"
    exit 1
fi

# 3. 서명 유효시간 확인 (120초)
NOW=$(date +%s)
AGE=$((NOW - HOOK_TS))
MAX_AGE=600

if [ "$AGE" -gt "$MAX_AGE" ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}[pre-push] ❌ HOOK_VERIFIED 서명 만료 (${AGE}초 경과, 최대 ${MAX_AGE}초)${NC}"
    echo -e "${RED}마지막 정상 커밋 이후 너무 오래되었거나,${NC}"
    echo -e "${RED}--no-verify로 커밋한 후 push를 시도했습니다.${NC}"
    echo -e "${YELLOW}해결: git commit --amend --no-edit  (pre-commit 재실행)${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
fi

echo -e "${GREEN}[pre-push] ✅ HOOK_VERIFIED 서명 확인 (${AGE}초 전)${NC}"
rm -f "$HOOK_FILE"
exit 0
