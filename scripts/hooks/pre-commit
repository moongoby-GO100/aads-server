#!/bin/bash
# API Key Leak Prevention Hook
# 커밋 시 API 키 패턴 자동 감지 → 차단

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ── 컨테이너 내부 커밋 차단 ──────────────────────────────────
# /app/.git 은 Docker 이미지에 내장된 임시본이라 호스트 레포에 전파되지 않는다.
# 컨테이너에서 git commit 을 하면 "성공했다"고 착각하지만 push 시 원격 미반영이라
# 명시적으로 차단하고 SSH 경유를 안내한다. 긴급 시 ALLOW_CONTAINER_COMMIT=1 로 우회.
if [ -f /.dockerenv ] && [ "${ALLOW_CONTAINER_COMMIT:-}" != "1" ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}[BLOCKED] 컨테이너 내부 git commit 차단${NC}"
    echo -e "${RED}  /app/.git 은 이미지 내부 임시본 — 호스트 레포 미전파${NC}"
    echo -e "${RED}  호스트에서 커밋하세요:${NC}"
    echo -e "${YELLOW}    ssh root@host.docker.internal \\${NC}"
    echo -e "${YELLOW}      'cd /root/aads/aads-server && git add <files> && git commit ...'${NC}"
    echo -e "${RED}  긴급 로컬 전용 커밋이 필요하면: ALLOW_CONTAINER_COMMIT=1 git commit ...${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED" ]; then
  HOOK_SIG="hook-verified:$(date +%s)"
  # 호스트 경로 고정. 쓰기 불가(ex. 컨테이너 RO mount)면 git rev-parse fallback.
  HOOK_DIR=$(git rev-parse --git-dir 2>/dev/null)
  if [ -z "$HOOK_DIR" ] || [ ! -w "$HOOK_DIR" ]; then
      HOOK_DIR="/root/aads/aads-server/.git"
  fi
  [ -n "$HOOK_DIR" ] && [ -w "$HOOK_DIR" ] && echo "$HOOK_SIG" > "$HOOK_DIR/HOOK_VERIFIED"
  exit 0
fi

PATTERNS=(
  'AIzaSy[a-zA-Z0-9_-]{20,}'
  'sk-ant-api[a-zA-Z0-9_-]{20,}'
  'sk-proj-[a-zA-Z0-9_-]{20,}'
  'gsk_[a-zA-Z0-9]{20,}'
  'sk-[a-f0-9]{28,}'
  'xoxb-[0-9]{10,}-[a-zA-Z0-9]+'
  'ghp_[a-zA-Z0-9]{30,}'
  'AKIA[0-9A-Z]{16}'
  'API_KEY=[A-Za-z0-9][A-Za-z0-9_-]{15,}'
)

FOUND=0
for file in $STAGED; do
  if [[ "$file" == *.env* ]] || [[ "$file" == .env* ]]; then continue; fi
  for pattern in "${PATTERNS[@]}"; do
    MATCHES=$(git diff --cached -- "$file" | grep -P "^\+" | grep -oP "$pattern" 2>/dev/null)
    if [ -n "$MATCHES" ]; then
      echo -e "${RED}[BLOCKED] API 키 감지됨\! 파일: $file${NC}"
      echo -e "${RED}  값: ${MATCHES:0:20}...${NC}"
      FOUND=1
    fi
  done
done

if [ $FOUND -ne 0 ]; then
  echo -e "${RED}커밋 차단됨: API 키가 포함된 파일이 있습니다.${NC}"
  exit 1
fi

# ─── Step 2: Python 코드 검수 (구문 + 정적 분석 + import 검증) ───
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
PY_FILES=$(echo "$STAGED" | grep '\.py$' || true)
if [ -n "$PY_FILES" ]; then
  echo "[pre-commit] Python 코드 검수 시작..."
  PY_ERRORS=0

  for f in $PY_FILES; do
    [ -f "$f" ] || continue

    # 구문 검사
    if ! python3 -c "import ast; ast.parse(open('$f').read())" 2>/dev/null; then
      echo -e "  ${RED}❌ 구문 오류: $f${NC}"
      PY_ERRORS=$((PY_ERRORS + 1))
      continue
    fi

    # ruff 정적 분석 (undefined name, unused import 등)
    if command -v ruff &>/dev/null; then
      RUFF_OUT=$(ruff check --select F821,F811 "$f" 2>&1 || true)
      if [ -n "$RUFF_OUT" ] && ! echo "$RUFF_OUT" | grep -q "All checks passed"; then
        echo -e "  ${RED}❌ 정적 분석 오류: $f${NC}"
        echo "$RUFF_OUT" | head -3
        PY_ERRORS=$((PY_ERRORS + 1))
        continue
      fi
    fi

    # Docker import 검증 (app/ 하위 파일만)
    # Use the staged worktree, not the running /app inside aads-server. New
    # modules do not exist in the active container until the release image is
    # built, so docker exec causes false negatives for additive API files.
    if [[ "$f" == app/* ]]; then
      MODULE=$(echo "$f" | sed 's|/|.|g' | sed 's|\.py$||')
      IMPORT_IMAGE=$(docker inspect -f '{{.Config.Image}}' aads-server 2>/dev/null || true)
      ENV_FILE_ARGS=()
      if [ -f "$(pwd)/.env" ]; then
        ENV_FILE_ARGS=(--env-file "$(pwd)/.env")
      elif [ -f "/root/aads/aads-server/.env" ]; then
        ENV_FILE_ARGS=(--env-file /root/aads/aads-server/.env)
      else
        ENV_FILE_ARGS=(
          -e JWT_SECRET_KEY="precommit-test-secret"
          -e AADS_ADMIN_PASSWORD="precommit-test-admin"
          -e E2B_API_KEY="precommit-test-e2b"
        )
      fi
      if [ -n "$IMPORT_IMAGE" ]; then
        IMPORT_OUT=$(docker run --rm \
          "${ENV_FILE_ARGS[@]}" \
          -e PYTHONPATH=/app \
          -v "$(pwd):/app:ro" -w /app --entrypoint python \
          "$IMPORT_IMAGE" -c "import $MODULE" 2>&1)
        IMPORT_RC=$?
      else
        IMPORT_OUT=$(python3 -c "import $MODULE" 2>&1)
        IMPORT_RC=$?
      fi
      if [ "$IMPORT_RC" -ne 0 ]; then
        ERR=$(echo "$IMPORT_OUT" | grep -E "Error" | tail -1)
        echo -e "  ${RED}❌ import 실패: $MODULE${NC}"
        echo "     $ERR"
        PY_ERRORS=$((PY_ERRORS + 1))
        continue
      fi
    fi

    echo -e "  ${GREEN}✅${NC} $f"
  done

  if [ $PY_ERRORS -gt 0 ]; then
    echo -e "${RED}커밋 차단: Python 검수 실패 ${PY_ERRORS}건${NC}"
    exit 1
  fi
  echo -e "${GREEN}[pre-commit] Python 검수 통과${NC}"

  # Step 3: 단위 테스트 (도구/핵심 코드 변경 시 항상 실행)
  TEST_FILE="tests/unit/test_tools_and_pipeline.py"
  # 도구 관련 파일 변경 감지 — 테스트 파일뿐 아니라 코드 변경에도 테스트 실행
  TOOL_FILES_PATTERN="tool_executor\|tool_registry\|ceo_chat_tools\|chat_tools\|model_selector\|system_prompt\|test_tools"
  TOOL_MODIFIED=$(echo "$PY_FILES" | grep -c "$TOOL_FILES_PATTERN" || true)
  if [ -f "$TEST_FILE" ] && [ "$TOOL_MODIFIED" -gt 0 ]; then
    echo "[pre-commit] 도구/핵심 코드 변경 감지 — 단위 테스트 실행..."
    docker cp "$TEST_FILE" aads-server:/app/tests/unit/test_tools_and_pipeline.py 2>/dev/null
    TEST_OUT=$(docker exec aads-server python3 -m pytest tests/unit/test_tools_and_pipeline.py -q --tb=line 2>&1 || true)
    if echo "$TEST_OUT" | grep -q "failed"; then
      FAIL_COUNT=$(echo "$TEST_OUT" | grep -oP '\d+ failed' | head -1)
      echo -e "  ${RED}❌ 테스트 실패: ${FAIL_COUNT}${NC}"
      echo "$TEST_OUT" | grep "FAILED" | head -5
      PY_ERRORS=$((PY_ERRORS + 1))
    else
      PASS_COUNT=$(echo "$TEST_OUT" | grep -oP '\d+ passed' | head -1)
      echo -e "  ${GREEN}✅ 테스트 통과: ${PASS_COUNT}${NC}"
    fi
  elif [ -f "$TEST_FILE" ]; then
    echo "[pre-commit] 도구 관련 파일 미변경 — 테스트 생략"
  fi

  # Step 4: 도구 등록 정합성 검증 + 자동 수정
  if echo "$PY_FILES" | grep -qE 'tool_registry|tool_executor|ceo_chat_tools'; then
    echo "[pre-commit] 도구 정합성 검증..."
    TOOL_CHECK=$(python3 scripts/check_tool_consistency.py 2>&1)
    if [ $? -ne 0 ]; then
      echo -e "  ${RED}${TOOL_CHECK}${NC}"
      echo "[pre-commit] 자동 수정 시도..."
      FIX_OUT=$(python3 scripts/check_tool_consistency.py --fix 2>&1)
      if [ $? -eq 0 ]; then
        echo -e "  ${GREEN}${FIX_OUT}${NC}"
        echo "[pre-commit] 수정된 파일을 staging에 추가합니다..."
        git add app/services/tool_executor.py app/services/tool_registry.py 2>/dev/null
        # 수정 후 재검증
        RECHECK=$(python3 scripts/check_tool_consistency.py 2>&1)
        if [ $? -ne 0 ]; then
          echo -e "  ${RED}자동 수정 후에도 검증 실패:${NC}"
          echo -e "  ${RED}${RECHECK}${NC}"
          PY_ERRORS=$((PY_ERRORS + 1))
        else
          echo -e "  ${GREEN}${RECHECK}${NC}"
        fi
      else
        echo -e "  ${RED}자동 수정 실패 — 수동 수정 필요${NC}"
        PY_ERRORS=$((PY_ERRORS + 1))
      fi
    else
      echo -e "  ${GREEN}${TOOL_CHECK}${NC}"
    fi
  fi

  if [ $PY_ERRORS -gt 0 ]; then
    echo -e "${RED}커밋 차단: 검수 실패 ${PY_ERRORS}건${NC}"
    exit 1
  fi
fi


# ── R-AUTH 위반 감지 ──────────────────────────────────────
# ANTHROPIC_API_KEY를 직접 참조하는 새 코드 차단 (R-AUTH 규칙)
RAUTH_VIOLATIONS=0
for file in $STAGED; do
  if [[ "$file" != *.py ]]; then continue; fi
  if [[ "$file" == *.bak* ]]; then continue; fi
  RAUTH_MATCH=$(git diff --cached -- "$file" | grep -P "^\+" | grep -v "^+++" | grep "ANTHROPIC_API_KEY" | grep -v "FALLBACK" | grep -v "AUTH_TOKEN" | grep -v "#.*R-AUTH" | grep -v "\.bak")
  if [ -n "$RAUTH_MATCH" ]; then
    echo -e "${RED}[R-AUTH 위반] ANTHROPIC_API_KEY 직접 사용 감지! 파일: $file${NC}"
    echo -e "${RED}  AADS는 Auth Token(ANTHROPIC_AUTH_TOKEN) 사용 — API Key 금지${NC}"
    echo -e "${RED}  → anthropic_client.py의 call_llm_with_fallback() 사용하세요${NC}"
    RAUTH_VIOLATIONS=$((RAUTH_VIOLATIONS + 1))
  fi
done
if [ $RAUTH_VIOLATIONS -gt 0 ]; then
  echo -e "${RED}커밋 차단: R-AUTH 위반 ${RAUTH_VIOLATIONS}건 — CEO 승인 필요${NC}"
  exit 1
fi

# ── AUTH 핵심 파일 보호 (CEO 승인 필수) ──────────────────────
# 인증 경로에 직접 영향을 주는 파일 수정 시 커밋 차단
# CEO가 직접 승인할 때만 --allow-auth 플래그로 우회 가능
AUTH_PROTECTED_FILES=(
  "app/core/anthropic_client.py"
  "app/core/auth_provider.py"
  "app/services/model_selector.py"
  "app/llm/client.py"
  "docker-compose.yml"
  "scripts/claude_relay_server.py"
)

if [ "${ALLOW_AUTH_COMMIT:-}" != "1" ]; then
  AUTH_BLOCKED=0
  for file in $STAGED; do
    for protected in "${AUTH_PROTECTED_FILES[@]}"; do
      if [[ "$file" == "$protected" ]]; then
        echo -e "${RED}[AUTH 보호] 인증 핵심 파일 수정 감지: $file${NC}"
        AUTH_BLOCKED=$((AUTH_BLOCKED + 1))
      fi
    done
  done
  if [ $AUTH_BLOCKED -gt 0 ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}커밋 차단: 인증 핵심 파일 ${AUTH_BLOCKED}건 수정됨${NC}"
    echo -e "${RED}이 파일들은 전체 채팅 시스템에 영향을 줍니다.${NC}"
    echo -e "${RED}CEO 승인 후 다음 명령으로 커밋하세요:${NC}"
    echo -e "${YELLOW}  ALLOW_AUTH_COMMIT=1 git commit -m \"...\"${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
  fi
fi

# ── 채팅 관련 파일 수정 시 smoke test 실행 ──────────────────
CHAT_FILES=(
  "app/services/chat_service.py"
  "app/core/anthropic_client.py"
  "app/core/auth_provider.py"
  "app/services/model_selector.py"
  "app/llm/client.py"
)
CHAT_MODIFIED=0
for file in $STAGED; do
  for cf in "${CHAT_FILES[@]}"; do
    if [[ "$file" == "$cf" ]]; then
      CHAT_MODIFIED=1
      break 2
    fi
  done
done

if [ $CHAT_MODIFIED -eq 1 ]; then
  echo "[pre-commit] 채팅 파일 변경 감지 — LLM 호출 smoke test 실행..."
  SMOKE_OUT=$(timeout 30 docker exec aads-server-green python3 -c "
import asyncio, sys
sys.path.insert(0, '/app')
async def test():
    from app.core.anthropic_client import call_llm_with_fallback
    r = await call_llm_with_fallback('say OK', model='claude-haiku-4-5-20251001', max_tokens=10)
    if r and r.strip():
        print('SMOKE_PASS')
    else:
        print('SMOKE_FAIL: empty response')
asyncio.run(test())
" 2>&1)
  if echo "$SMOKE_OUT" | grep -q "SMOKE_PASS"; then
    echo -e "  ${GREEN}✅ LLM smoke test 통과${NC}"
  else
    echo -e "  ${RED}❌ LLM smoke test 실패:${NC}"
    echo "$SMOKE_OUT" | tail -3
    echo -e "${RED}⚠️ LLM smoke test 실패 (외부 서비스 장애 가능) — 커밋은 허용${NC}"
    echo -e "${YELLOW}  smoke test 실패는 경고로 처리합니다${NC}"
  fi
fi

# ── 커밋 완결성: 스테이지된 파일이 미추적 파일을 import 하는가 ──────────
# 2026-09-12: settings/page.tsx 가 ModelSettingsPanel 을 import 한 채 커밋됐으나
# 컴포넌트 파일은 git add 되지 않아, 깨끗한 체크아웃에서 빌드가 불가능했다.
# 중단된 턴이 재개되며 일부 파일만 커밋된 결과였다. 그 자리에서 잡는다.
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|py)$' || true)
if [ -n "$STAGED_SRC" ]; then
    MISSING=$(python3 - <<'PYEOF'
import os, re, subprocess, sys

staged = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
                        capture_output=True, text=True).stdout.split()
tracked = set(subprocess.run(["git", "ls-files"], capture_output=True, text=True).stdout.split())
tracked |= set(staged)

# 상대 경로 import 와 @/ 별칭(= src/) 만 본다. 패키지 import 는 제외.
pat = re.compile(r"""(?:from|import)\s+['"]((?:\.{1,2}/|@/)[^'"]+)['"]""")
exts = ("", ".ts", ".tsx", ".js", ".jsx", "/index.ts", "/index.tsx", "/index.js")
missing = []
for f in staged:
    if not f.endswith((".ts", ".tsx", ".js", ".jsx")) or not os.path.exists(f):
        continue
    try:
        text = open(f, encoding="utf-8", errors="replace").read()
    except OSError:
        continue
    for spec in pat.findall(text):
        base = "src/" + spec[2:] if spec.startswith("@/") else os.path.normpath(
            os.path.join(os.path.dirname(f), spec))
        if any((base + e) in tracked for e in exts):
            continue
        if any(os.path.exists(base + e) for e in exts):
            missing.append("%s -> %s (파일은 있으나 git 미추적)" % (f, spec))
        # 파일 자체가 없으면 빌드가 어차피 실패하므로 여기서는 다루지 않는다.
print("\n".join(missing))
PYEOF
)
    if [ -n "$MISSING" ]; then
        echo -e "${RED}[커밋 완결성] 커밋될 파일이 미추적 파일을 import 합니다${NC}"
        echo "$MISSING" | sed 's/^/  /'
        echo -e "${YELLOW}  → 해당 파일을 git add 하거나 import 를 제거하세요.${NC}"
        echo -e "${YELLOW}  → 이대로 커밋하면 깨끗한 체크아웃에서 빌드가 실패합니다.${NC}"
        exit 1
    fi
    echo -e "${GREEN}[커밋 완결성] import 대상 모두 추적됨${NC}"
fi

# ── 감사: hook 통과 서명 (--no-verify 우회 감지용) ──────────────────
HOOK_SIG="hook-verified:$(date +%s)"
# 호스트 경로 고정. 쓰기 불가(ex. 컨테이너 RO mount)면 git rev-parse fallback.
HOOK_DIR=$(git rev-parse --git-dir 2>/dev/null)
if [ -z "$HOOK_DIR" ] || [ ! -w "$HOOK_DIR" ]; then
    HOOK_DIR="/root/aads/aads-server/.git"
fi
if [ -n "$HOOK_DIR" ] && [ -w "$HOOK_DIR" ]; then
    echo "$HOOK_SIG" > "$HOOK_DIR/HOOK_VERIFIED"
fi

exit 0
