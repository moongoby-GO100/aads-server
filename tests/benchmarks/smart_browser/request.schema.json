{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "fixture",
    "input_hash",
    "base_url",
    "trial"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "seed",
        "version",
        "reset",
        "permissions",
        "inputs",
        "goal_postcondition",
        "acceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "reset": {
          "type": "string",
          "minLength": 1
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenant",
            "project",
            "origins",
            "actions"
          ],
          "properties": {
            "tenant": {
              "type": "string",
              "minLength": 1
            },
            "project": {
              "type": "string",
              "minLength": 1
            },
            "origins": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task",
            "path",
            "key"
          ],
          "properties": {
            "task": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "goal_postcondition": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_url": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])(?![\\s\\S])",
      "description": "Canonical HTTP root origin, explicit port 1..65535; no userinfo, path (including /), query or fragment; no leading zeros."
    },
    "trial": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
