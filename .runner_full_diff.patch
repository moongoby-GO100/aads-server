+class FakeDB:
+    def __init__(self) -> None:
+        self.businesses = {
+            BUSINESS: {
+                "id": BUSINESS, "tenant_id": TENANT_A, "name": "언니냉면",
+                "registration_no": "기초등록 필요", "representative": "미등록",
+                "tax_type": "일반과세", "opened_at": "", "address": "",
+            },
+        }
+        self.documents: list[dict] = []
+        self.audits: list[dict] = []
