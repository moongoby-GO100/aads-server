+    if [[ "$(get_job_status "$job_id")" != "awaiting_approval" ]]; then
+        _fail_job "$job_id" "$session_id" "deploy_rebase_review_persist_failed" "새 SHA 재검수 승인 대기 상태 저장 실패"
