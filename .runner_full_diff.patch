+@pytest.mark.parametrize("phase,detail", [
+    ("deploy_isolated_push_state", "승인 SHA push 사전판별 실패: fetch_fail"),
+    ("error", "deploy_isolated_push_state: fetch_fail"),
+])
+def test_fetch_failure_does_not_submit_rework(phase, detail):
