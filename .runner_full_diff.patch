+        <td>${item.check_out_at ? `${Math.floor(item.worked_minutes / 60)}시간 ${item.worked_minutes % 60}분` : "—"}</td>
+        <td>${resultLabel[item.geofence_result] || "—"}</td><td>${esc(statusLabel[item.status] || item.status)}</td><td>${esc(item.memo)}</td>
+      </tr>`).join("") || '<tr><td colspan="9" class="muted">PWA 출퇴근 기록이 없습니다.</td></tr>';
+  }
+  async function loadLocations() {
+    const params = new URLSearchParams();
+    if ($("dateFrom").value) params.set("date_from", $("dateFrom").value);
+    if ($("dateTo").value) params.set("date_to", $("dateTo").value);
+    if ($("resultFilter").value) params.set("result", $("resultFilter").value);
+    const data = await api(`/${biz()}/attendance/locations?${params}`);
+    state.locations = data.records;
+    const s = data.summary;
+    $("locationSummary").textContent = `${data.count}건 · 반경 안 ${s.inside} · 반경 밖 ${s.outside} · 판정 불가 ${s.unknown} · 확인필요 ${s.pending}`;
+    renderLocations();
+  }
+  $("loadLocationsBtn").addEventListener("click", () => loadLocations().catch(showError));
+  $("showCoords").addEventListener("change", renderLocations);
+  $("businessSelect").addEventListener("change", event => {
+    state.businessId = event.target.value;
+    Promise.all([loadBranches(), loadLocations()]).catch(showError);
+  });
+
+  (async () => {
+    try {
+      const { businesses } = await api("/businesses");
+      $("businessSelect").innerHTML = businesses.map(item => `<option value="${esc(item.id)}">${esc(item.name)}</option>`).join("");
+      state.businessId = businesses[0]?.id || "";
+      if (!state.businessId) throw new Error("현재 테넌트에 사업자가 없습니다.");
+      await Promise.all([loadBranches(), loadLocations()]);
+    } catch (error) {
+      showError(error);
+    }
+  })();
+})();
+</script>
+</body>
+</html>
