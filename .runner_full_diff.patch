+    where = queued_sql[queued_sql.index("WHERE"):queued_sql.index("ORDER BY")]
+    # 필터는 DISTINCT ON 보다 먼저(WHERE) 적용돼야 대상당 "멈추지 않은 것 중 가장 오래된" 것을 집는다.
+    assert "NOT EXISTS" in where and "g.paused_at IS NOT NULL" in where
