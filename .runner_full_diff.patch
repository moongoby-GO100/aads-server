+                    "WHERE id = $1::uuid AND tenant_id = $3::uuid",
+                    milestone_id, json.dumps(evidence), row["tenant_id"],
+                )
+                count += 1
+                logger.info("goal_retry_link_superseded milestone=%s failed=%s replacement=%s",
+                            milestone_id, failed_id, replacement["task_id"])
+    return count
