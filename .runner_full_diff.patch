+                      {active_link_predicate(columns, 'l')}""",
+                milestone_id, row["goal_id"], row["tenant_id"],
+                replacement["task_id"], failed_id,
+            )
+            if result == "UPDATE 1":
+                candidate["superseded_by_task_id"] = replacement["task_id"]
+                await conn.execute(
