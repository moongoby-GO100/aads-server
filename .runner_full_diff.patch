+class _Log:
+    """dispatch 경로가 남긴 warning 이벤트만 모으는 최소 로거."""
+
+    def __init__(self) -> None:
+        self.events: list[str] = []
+
+    def warning(self, event, **_fields) -> None:
+        self.events.append(event)
+
+    def info(self, *_args, **_kwargs) -> None:
+        pass
