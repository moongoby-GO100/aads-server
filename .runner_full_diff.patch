+
+<script>
+(() => {
+  "use strict";
+  // 인증 토큰은 오비서 본 화면(index.html)과 같은 키를 읽기만 한다. 서비스워커는 토큰을 보지 않는다.
+  const SERVER_AUTH_TOKEN_KEY = "aads_token";
+  const FB_ACCESS_TOKEN_KEY = "fb_access_token";
+  const BUSINESS_KEY = "obys_clock_business_id";
+  const BRANCH_KEY = "obys_clock_branch_id";
+  const DECLINED_KEY = "obys_clock_location_declined";  // "동의하지 않음" 을 고른 기기
+  const $ = id => document.getElementById(id);
+  const state = { businessId: "", clock: null, pending: null, timer: null, installPrompt: null };
+
+  function cookieValue(name) {
+    const target = `${encodeURIComponent(name)}=`;
+    return document.cookie.split(";").map(item => item.trim())
+      .find(item => item.startsWith(target))?.slice(target.length) || "";
+  }
+  function token() {
+    return localStorage.getItem(SERVER_AUTH_TOKEN_KEY) || localStorage.getItem(FB_ACCESS_TOKEN_KEY)
+      || cookieValue(SERVER_AUTH_TOKEN_KEY) || cookieValue(FB_ACCESS_TOKEN_KEY);
+  }
+
+  async function api(path, options = {}) {
+    if (!navigator.onLine) throw Object.assign(new Error("인터넷에 연결되어 있지 않습니다."), { offline: true });
+    const controller = new AbortController();
+    const timeoutId = setTimeout(() => controller.abort(), 15000);
+    let response;
+    try {
+      response = await fetch(`/api/v1/workspaces${path}`, {
+        ...options,
+        cache: "no-store",
+        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token()}` },
+        signal: controller.signal
+      });
+    } catch (error) {
+      throw Object.assign(new Error(error?.name === "AbortError"
+        ? "서버 응답이 15초 안에 오지 않았습니다." : "서버에 연결할 수 없습니다."), { offline: true });
+    } finally {
+      clearTimeout(timeoutId);
+    }
+    const payload = await response.json().catch(() => ({}));
+    if (!response.ok) {
+      const detail = typeof payload.detail === "string" ? payload.detail : (payload.detail?.message || `오류 ${response.status}`);
+      throw Object.assign(new Error(detail), { status: response.status });
+    }
+    return payload;
+  }
+
+  function show(id, visible) { $(id).hidden = !visible; }
+
+  function showError(error, retry) {
+    state.pending = retry || null;
+    $("errorTitle").textContent = error.offline ? "지금 기록할 수 없음" : "기록하지 못했습니다";
+    $("errorText").textContent = error.offline
+      ? `${error.message} 연결을 확인한 뒤 다시 시도하십시오. 오프라인 기록은 저장하지 않습니다.`
+      : error.message;
+    show("retryBtn", Boolean(retry));
+    show("errorView", true);
+  }
+  function clearError() { show("errorView", false); state.pending = null; }
+
+  function hhmm(iso) {
+    if (!iso) return "";
+    return new Date(iso).toLocaleTimeString("ko-KR", { hour: "2-digit", minute: "2-digit", hour12: false });
+  }
+  function verdictBadge(record) {
+    if (!record) return "";
+    if (record.status === "approved") return '<span class="badge ok">자동 확정</span>';
+    if (record.status === "rejected") return '<span class="badge warn">반려</span>';
+    if (record.geofence_result === "outside") return '<span class="badge warn">확인필요 · 매장 반경 밖</span>';
+    return '<span class="badge warn">확인필요</span>';
+  }
+  function tickElapsed(since) {
+    clearInterval(state.timer);
+    const el = $("todayElapsed");
+    if (!since) { el.hidden = true; return; }
+    const render = () => {
+      const minutes = Math.max(0, Math.floor((Date.now() - new Date(since).getTime()) / 60000));
+      el.textContent = `${Math.floor(minutes / 60)}시간 ${String(minutes % 60).padStart(2, "0")}분 근무 중`;
+    };
+    render();
+    el.hidden = false;
+    state.timer = setInterval(render, 30000);
+  }
+
+  function consentAgreed() { return Boolean(state.clock?.consent?.agreed); }
+
+  function render() {
+    const clock = state.clock;
+    $("whoName").textContent = clock.employee.name;
+    $("whoBusiness").textContent = clock.business.name;
+    const needsConsent = !consentAgreed() && localStorage.getItem(DECLINED_KEY) !== "1";
+    show("consentView", needsConsent);
+    show("todayView", !needsConsent);
+    show("clockBtn", !needsConsent);
+    $("consentToggleBtn").textContent = consentAgreed() ? "위치 동의 철회" : "위치 동의하기";
+    show("consentToggleBtn", !needsConsent);
+
+    const open = clock.open_record;
+    const last = open || clock.today[0] || null;
+    $("todayDate").textContent = new Date(clock.server_time).toLocaleDateString("ko-KR", { month: "long", day: "numeric", weekday: "short" });
+    if (open) {
+      $("todayStatus").textContent = `근무 중 · ${hhmm(open.check_in_at)} 출근`;
+      tickElapsed(open.check_in_at);
+    } else if (last && last.check_out_at) {
+      $("todayStatus").textContent = `퇴근 완료 · ${hhmm(last.check_in_at)}~${hhmm(last.check_out_at)} (${Math.floor(last.worked_minutes / 60)}시간 ${last.worked_minutes % 60}분)`;
+      tickElapsed(null);
+    } else {
+      $("todayStatus").textContent = "아직 출근 전입니다";
+      tickElapsed(null);
+    }
+    $("todayVerdict").innerHTML = verdictBadge(last);
+    $("todayReason").textContent = last?.memo || (consentAgreed() ? "" : "위치 미동의 — 기록은 확인필요로 남습니다.");
+
+    const btn = $("clockBtn");
+    btn.textContent = open ? "퇴근" : "출근";
+    btn.classList.toggle("out", Boolean(open));
+    btn.disabled = false;
+
+    const branches = clock.branches || [];
+    show("branchView", !open && branches.length > 1);
+    if (branches.length > 1) {
+      const saved = localStorage.getItem(BRANCH_KEY) || "";
+      $("branchSelect").innerHTML = branches.map(item =>
+        `<option value="${encodeURIComponent(item.id)}">${item.name.replace(/[<>&"]/g, "")}${item.has_geofence ? "" : " (위치 미등록)"}</option>`).join("");
+      if (branches.some(item => item.id === saved)) $("branchSelect").value = encodeURIComponent(saved);
+    }
+  }
+
+  async function loadState() {
+    clearError();
+    try {
+      state.clock = await api(`/${encodeURIComponent(state.businessId)}/attendance/clock/state`);
+      render();
+    } catch (error) {
+      if (error.status === 401) { show("loginView", true); return; }
+      showError(error, loadState);
+    }
+  }
+
+  async function loadBusinesses() {
+    if (!token()) { show("loginView", true); return; }
+    try {
+      const { businesses } = await api("/businesses");
+      if (!businesses.length) throw new Error("연결된 사업장이 없습니다. 사장님께 직원 등록을 요청하십시오.");
+      const saved = localStorage.getItem(BUSINESS_KEY);
+      state.businessId = businesses.some(item => item.id === saved) ? saved : businesses[0].id;
+      if (businesses.length > 1) {
+        $("businessSelect").innerHTML = businesses.map(item =>
+          `<option value="${encodeURIComponent(item.id)}">${item.name.replace(/[<>&"]/g, "")}</option>`).join("");
+        $("businessSelect").value = encodeURIComponent(state.businessId);
+        show("businessView", true);
+      }
+      await loadState();
+    } catch (error) {
+      if (error.status === 401) { show("loginView", true); return; }
+      showError(error, loadBusinesses);
+    }
+  }
+
+  // 위치는 버튼을 누른 순간 1회만 읽는다. 연속 추적·백그라운드·주기 수집은 쓰지 않는다.
+  function readPositionOnce() {
+    return new Promise((resolve, reject) => {
+      if (!("geolocation" in navigator)) { reject(Object.assign(new Error("이 기기는 위치를 지원하지 않습니다."), { code: 2 })); return; }
+      navigator.geolocation.getCurrentPosition(resolve, reject, { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 });
+    });
+  }
+
+  async function submitClock(withLocation) {
+    const open = state.clock.open_record;
+    const action = open ? "check-out" : "check-in";
+    const body = {
+      location_consent: consentAgreed() && withLocation,
+      device_info: navigator.userAgent.slice(0, 300)
+    };
+    if (!open && (state.clock.branches || []).length > 1) {
+      body.branch_id = decodeURIComponent($("branchSelect").value);
+      localStorage.setItem(BRANCH_KEY, body.branch_id);
+    }
+    if (body.location_consent) {
+      try {
+        const position = await readPositionOnce();
+        body.latitude = position.coords.latitude;
+        body.longitude = position.coords.longitude;
+        body.accuracy_m = position.coords.accuracy;
+      } catch (error) {
+        if (error.code === 1) {  // PERMISSION_DENIED
+          show("permissionView", true);
+          return;
+        }
+        showError(new Error(`위치를 읽지 못했습니다(${error.code === 3 ? "시간 초과" : "측정 실패"}). 다시 시도하거나 '위치 없이 기록'을 누르십시오.`),
+                  () => runClock(true));
+        show("permissionView", true);
+        return;
+      }
+    }
+    await api(`/${encodeURIComponent(state.businessId)}/attendance/${action}`, { method: "POST", body: JSON.stringify(body) });
+    show("permissionView", false);
+    await loadState();
+  }
+
+  async function runClock(withLocation) {
+    clearError();
+    const btn = $("clockBtn");
+    btn.disabled = true;
+    btn.textContent = "기록 중…";
+    try {
+      await submitClock(withLocation);
+    } catch (error) {
+      // 409(이미 출근·출근 없음)는 화면 상태가 낡은 것이다 — 새 상태를 받은 뒤 오류를 보인다.
+      if (error.status === 409) await loadState();
+      showError(error, () => runClock(withLocation));
+    } finally {
+      if (state.clock) render();
+    }
+  }
+
+  async function saveConsent(agree) {
+    clearError();
+    try {
+      await api(`/${encodeURIComponent(state.businessId)}/attendance/consent`, { method: "POST", body: JSON.stringify({ agree }) });
+      if (agree) localStorage.removeItem(DECLINED_KEY); else localStorage.setItem(DECLINED_KEY, "1");
+      await loadState();
+    } catch (error) {
+      showError(error, () => saveConsent(agree));
+    }
+  }
+
+  $("consentAgreeBtn").addEventListener("click", () => saveConsent(true));
+  $("consentDeclineBtn").addEventListener("click", () => { localStorage.setItem(DECLINED_KEY, "1"); render(); });
+  $("consentToggleBtn").addEventListener("click", () => {
+    if (consentAgreed()) {
+      if (confirm("위치 동의를 철회하면 이후 출퇴근은 위치 없이 기록되고 모두 확인필요로 남습니다. 철회할까요?")) saveConsent(false);
+    } else {
+      saveConsent(true);
+    }
+  });
+  $("clockBtn").addEventListener("click", () => runClock(true));
+  $("retryLocationBtn").addEventListener("click", () => { show("permissionView", false); runClock(true); });
+  $("withoutLocationBtn").addEventListener("click", () => { show("permissionView", false); runClock(false); });
+  $("retryBtn").addEventListener("click", () => state.pending?.());
+  $("refreshBtn").addEventListener("click", () => (state.businessId ? loadState() : loadBusinesses()));
+  $("businessSelect").addEventListener("change", event => {
+    state.businessId = decodeURIComponent(event.target.value);
+    localStorage.setItem(BUSINESS_KEY, state.businessId);
+    loadState();
+  });
+  window.addEventListener("online", () => { if (!$("errorView").hidden && state.pending) state.pending(); });
+
+  // 설치 안내 — Android 는 설치 버튼, iOS 는 공유 메뉴 안내.
+  const standalone = matchMedia("(display-mode: standalone)").matches || navigator.standalone === true;
+  if (!standalone) {
+    show("installView", true);
+    if (/iphone|ipad|ipod/i.test(navigator.userAgent)) {
+      $("installHint").textContent = "Safari 아래쪽 공유 버튼 → '홈 화면에 추가'를 누르면 앱처럼 설치됩니다.";
+    }
+  }
+  window.addEventListener("beforeinstallprompt", event => {
+    event.preventDefault();
+    state.installPrompt = event;
+    show("installBtn", true);
+  });
+  $("installBtn").addEventListener("click", async () => {
+    if (!state.installPrompt) return;
+    state.installPrompt.prompt();
+    await state.installPrompt.userChoice.catch(() => null);
+    state.installPrompt = null;
+    show("installBtn", false);
+  });
+
+  if ("serviceWorker" in navigator) {
+    navigator.serviceWorker.register("/static/apps/obys/sw.js", { scope: "/static/apps/obys/" }).catch(() => {});
+  }
+  loadBusinesses();
+})();
+</script>
+</body>
+</html>
