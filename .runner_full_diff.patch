+        ["bash", "-c", f'source "{fn}"; acquire_deploy_lock_with_requeue job-w AADS sess || true'],
+        env={"PATH": "/usr/bin:/bin", "WORK": str(work), "FAKE_FOLLOWING": following,
+             "DEPLOY_LOCK_MAX_WAIT_SEC": "200"},
+        capture_output=True, text=True, timeout=30,
