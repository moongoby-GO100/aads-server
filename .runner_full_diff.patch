+    assert re.search(rf"^GOAL_ID: {GOAL_ID}$", message, re.MULTILINE)
+    assert re.search(rf"^MILESTONE_ID: {MILESTONE_ID}$", message, re.MULTILINE)
+    assert "이 두 줄을 지시서에 그대로 넣어라" in message
+
