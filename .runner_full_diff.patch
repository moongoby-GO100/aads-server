+    "uploaded_ledger_row": ("yeoljeong_uploaded_ledger_rows", "occurred_on", "amount", "description", ""),
+    "manual_ledger_entry": ("yeoljeong_manual_ledger_entries", "occurred_on", "total_amount", "description", "AND deleted_at IS NULL"),
